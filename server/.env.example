# Use a direct PostgreSQL connection or the Supabase session pooler (port 5432).
# Either set DATABASE_URL without sslmode in the URL or set the PG* variables.
PGHOST=localhost
PGPORT=5432
PGDATABASE=kbtu_ums
PGUSER=postgres
PGPASSWORD=
# For Supabase, set PGSSLROOTCERT to the downloaded CA file or SUPABASE_CA_CERT to its PEM text.
# PGSSLROOTCERT=/path/to/prod-ca-2021.crt

PORT=4000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CURRENT_SEMESTER=Fall 2026
ALLOW_DEMO_TIME=false
SHOW_DEMO_ACCOUNTS=false

# Enable only for first-time setup on a trusted computer running the local portal.
LOCAL_INITIAL_SETUP=false

# Local labelled example grades, news, and messages. Disabled in production.
SHOW_STUDENT_DEMO_CONTENT=false
