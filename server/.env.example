# Copy this file to .env and write your pgAdmin password.
PGHOST=localhost
PGPORT=5432
PGDATABASE=kbtu_ums
PGUSER=postgres
PGPASSWORD=your_password_here

# Port of this server
PORT=4000
# Address of the website (Vite)
CORS_ORIGIN=http://localhost:5173
# true = the website may send a "time" to test past lessons (ses-8 was on 02.11).
# Must be false in a real system: then the server time is used.
ALLOW_DEMO_TIME=true
